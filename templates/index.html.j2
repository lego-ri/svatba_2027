<!DOCTYPE html>
<html lang="{{ wedding.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ site.title }}</title>
    <meta name="description" content="{{ site.meta_description }}">
    {% if privacy.robots_noindex %}
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet">
    {% endif %}

    <!-- Google Fonts: Caveat (rukopis), Montserrat (čistý text), Cormorant Garamond (detail) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

    {# ── Barevná paleta jako CSS proměnné ── #}
    <style>
        :root {
            --color-primary:        {{ colors.primary }};
            --color-secondary:      {{ colors.secondary }};
            --color-sage-light:     {{ colors.sage_light }};
            --color-sage-hover:     {{ colors.sage_hover }};
            --color-bg:             {{ colors.background }};
            --color-backdrop:       {{ colors.page_backdrop }};
            --color-text:           {{ colors.text }};
            --color-text-muted:     {{ colors.text_muted }};
            --color-border:         {{ colors.border }};
            --color-border-dark:    {{ colors.border_dark }};
        }
    </style>
    <link rel="stylesheet" href="static/style.css">
</head>
<body>

    <div class="page-container">
        <div class="invite-canvas">

            {# ═══════════════════════════════════════════════ #}
            {# HERO SECTION                                   #}
            {# ═══════════════════════════════════════════════ #}
            <header id="uvod" class="section hero-section">
                <h1 class="hero__names">{{ couple.name_a }} <span class="amp">&amp;</span> {{ couple.name_b }}</h1>
                
                <div class="hero__illustration">
                    <img src="static/images/bride-groom-date.png" alt="Kačí a Ričí — 12. 6. 2027" width="220" height="252" loading="eager">
                </div>

                <p class="hero__intro">
                    S velkou radostí a dojetím vás zveme, abyste s námi prožili jeden z nejkrásnějších dnů našeho života — náš svatební den.
                </p>
            </header>

            {# ═══════════════════════════════════════════════ #}
            {# STICKY NAV                                     #}
            {# ═══════════════════════════════════════════════ #}
            <nav id="nav" class="nav">
                <ul>
                    <li><a href="#misto">Místo</a></li>
                    <li><a href="#program">Program</a></li>
                    <li><a href="#dress-code">Dress code</a></li>
                    <li><a href="#ubytovani">Ubytování</a></li>
                    <li><a href="#dary">Dary</a></li>
                    <li><a href="#odpocet">Odpočet</a></li>
                    <li><a href="#kontakt">Kontakt</a></li>
                </ul>
            </nav>

            <main>

                {# ═══════════════════════════════════════════════ #}
                {# MÍSTO KONÁNÍ ("Vezmeme se!")                   #}
                {# ═══════════════════════════════════════════════ #}
                <section id="misto" class="section">
                    <h2 class="script-title">Vezmeme se!</h2>
                    <p class="venue-name">{{ venue.name }}</p>
                    <p class="section-text">
                        {{ venue.description }}
                    </p>
                    <div class="pill-buttons">
                        <a href="{{ venue.maps.google }}" target="_blank" rel="noopener" class="btn btn--pill">Otevřít Google Maps</a>
                        <a href="{{ venue.maps.mapy_cz }}" target="_blank" rel="noopener" class="btn btn--pill">Otevřít Mapy.cz</a>
                    </div>

                    <div class="sub-block">
                        <h3 class="sub-heading">Parkování</h3>
                        <p class="section-text-sm">{{ parking.description }}</p>
                        <div class="pill-buttons pill-buttons--sm">
                            <a href="{{ parking.maps.google }}" target="_blank" rel="noopener" class="btn btn--pill btn--sm">Parkoviště — Google Maps</a>
                            <a href="{{ parking.maps.mapy_cz }}" target="_blank" rel="noopener" class="btn btn--pill btn--sm">Parkoviště — Mapy.cz</a>
                        </div>
                    </div>

                    <div class="sub-block">
                        <h3 class="sub-heading">Doprava</h3>
                        <p class="section-text-sm">{{ transport.description }}</p>
                    </div>
                </section>

                <div class="doodle-divider">
                    <svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor">
                        <path d="M2 6C12 2 16 10 26 6C31 4 35 7 38 6" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </div>

                {# ═══════════════════════════════════════════════ #}
                {# PROGRAM DNE                                    #}
                {# ═══════════════════════════════════════════════ #}
                <section id="program" class="section">
                    <h2 class="script-title">Program dne</h2>
                    <div class="timeline">
                        {% for event in schedule %}
                        <div class="timeline__item">
                            <span class="timeline__time">{{ event.time }}</span>
                            <div class="timeline__body">
                                <h3>{{ event.title }}</h3>
                                {% if event.description %}
                                <p>{{ event.description }}</p>
                                {% endif %}
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </section>

                <div class="doodle-divider">
                    <svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor">
                        <path d="M2 6C12 2 16 10 26 6C31 4 35 7 38 6" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </div>

                {# ═══════════════════════════════════════════════ #}
                {# DRESS CODE                                     #}
                {# ═══════════════════════════════════════════════ #}
                <section id="dress-code" class="section">
                    <h2 class="script-title">Dress code</h2>
                    
                    <div class="section-icon">
                        <!-- Ruční skica obleku a šatů -->
                        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <!-- Ramínko a šaty -->
                            <path d="M38 18L44 24L52 23L50 50L38 52L38 24Z"/>
                            <path d="M44 14C44 12 46 11 47 13C48 15 45 17 44 18"/>
                            <path d="M42 24L46 51"/>
                            <!-- Pánský oblek -->
                            <path d="M14 22L20 18L26 22L28 48L12 48L14 22Z"/>
                            <path d="M20 14C20 12 22 11 23 13C24 15 21 17 20 18"/>
                            <path d="M17 22L20 30L23 22"/>
                            <path d="M20 30L20 48"/>
                        </svg>
                    </div>

                    <p class="script-subtitle">{{ dress_code.style }}</p>
                    <p class="section-text">{{ dress_code.description }}</p>
                    
                    <p class="warning-note">
                        {{ dress_code.terrain_warning }}
                    </p>

                    <!-- Paletka barev přesně jako na předloze -->
                    <div class="color-palette">
                        <p class="color-palette__title">Barevná inspirace pro hosty</p>
                        <div class="color-palette__dots">
                            {% for c in dress_code.palette %}
                            <div class="color-palette__item">
                                <span class="color-palette__dot" style="background-color: {{ c.hex }};" title="{{ c.name }}"></span>
                                <span class="color-palette__name">{{ c.name }}</span>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </section>

                <div class="doodle-divider">
                    <svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor">
                        <path d="M2 6C12 2 16 10 26 6C31 4 35 7 38 6" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </div>

                {# ═══════════════════════════════════════════════ #}
                {# UBYTOVÁNÍ                                      #}
                {# ═══════════════════════════════════════════════ #}
                <section id="ubytovani" class="section">
                    <h2 class="script-title">Ubytování</h2>

                    <div class="section-icon">
                        <!-- Skica stanu v přírodě -->
                        <svg width="60" height="52" viewBox="0 0 60 52" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 46L26 12L46 46H6Z"/>
                            <path d="M26 12L54 44L46 46"/>
                            <path d="M26 12V46"/>
                            <path d="M21 46L26 34L31 46"/>
                            <!-- Jemné hvězdičky / tráva -->
                            <path d="M2 48C5 47 7 47 10 48"/>
                            <path d="M48 48C51 47 54 47 57 48"/>
                            <path d="M48 10L49 13L52 14L49 15L48 18L47 15L44 14L47 13L48 10Z" fill="currentColor"/>
                        </svg>
                    </div>

                    <p class="section-text lead-text">{{ accommodation.description }}</p>
                </section>

                <div class="doodle-divider">
                    <svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor">
                        <path d="M2 6C12 2 16 10 26 6C31 4 35 7 38 6" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </div>

                {# ═══════════════════════════════════════════════ #}
                {# DARY                                           #}
                {# ═══════════════════════════════════════════════ #}
                <section id="dary" class="section">
                    <h2 class="script-title">Svatební dary</h2>

                    <div class="section-icon">
                        <!-- Skica dárkových krabiček s mašlí -->
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <!-- Spodní krabička -->
                            <rect x="12" y="28" width="32" height="22" rx="1"/>
                            <line x1="28" y1="28" x2="28" y2="50"/>
                            <line x1="12" y1="36" x2="44" y2="36"/>
                            <!-- Horní krabička -->
                            <rect x="16" y="16" width="24" height="12" rx="1"/>
                            <line x1="28" y1="16" x2="28" y2="28"/>
                            <!-- Mašlička -->
                            <path d="M28 16C24 10 20 12 24 15C26 16 28 16 28 16Z"/>
                            <path d="M28 16C32 10 36 12 32 15C30 16 28 16 28 16Z"/>
                            <!-- Padající stuhy -->
                            <path d="M26 16C23 18 21 21 20 25"/>
                            <path d="M30 16C33 18 35 21 36 25"/>
                        </svg>
                    </div>

                    <p class="section-text">{{ gifts.description }}</p>
                </section>

                <div class="doodle-divider">
                    <svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor">
                        <path d="M2 6C12 2 16 10 26 6C31 4 35 7 38 6" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </div>

                {# ═══════════════════════════════════════════════ #}
                {# ABY VÁS NIC NEPŘEKVAPILO                      #}
                {# ═══════════════════════════════════════════════ #}
                <section id="pozor" class="section">
                    <h2 class="script-title">{{ surprises.title }}</h2>

                    <div class="section-icon">
                        <!-- Skica deštníku s kapkami deště -->
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10 28C10 17 18 10 28 10C38 10 46 17 46 28C41 27 36 29 28 28C20 29 15 27 10 28Z"/>
                            <path d="M28 28V44C28 47 25 48 24 46"/>
                            <path d="M28 8V10"/>
                            <!-- Dešťové kapky -->
                            <path d="M14 36L12 40"/>
                            <path d="M42 36L44 40"/>
                            <path d="M36 42L35 46"/>
                        </svg>
                    </div>

                    <div class="surprises-list">
                        {% for item in surprises.entries %}
                        <div class="surprise-entry">
                            <h3 class="surprise-entry__title">{{ item.title }}</h3>
                            <p class="section-text">{{ item.description }}</p>
                        </div>
                        {% endfor %}
                    </div>
                </section>

                <div class="doodle-divider">
                    <svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor">
                        <path d="M2 6C12 2 16 10 26 6C31 4 35 7 38 6" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </div>

                {# ═══════════════════════════════════════════════ #}
                {# KONTAKTY                                       #}
                {# ═══════════════════════════════════════════════ #}
                <section id="kontakt" class="section">
                    <h2 class="script-title">Kontakty</h2>

                    <div class="section-icon">
                        <!-- Skica retro telefonu -->
                        <svg width="52" height="52" viewBox="0 0 52 52" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <!-- Sluchátko -->
                            <path d="M12 18C15 14 37 14 40 18C42 21 38 24 35 22C33 20 31 20 26 20C21 20 19 20 17 22C14 24 10 21 12 18Z"/>
                            <!-- Tělo telefonu -->
                            <path d="M16 26H36L40 40H12L16 26Z"/>
                            <circle cx="26" cy="33" r="4"/>
                            <!-- Šňůra -->
                            <path d="M14 34C11 36 10 39 12 42C13 44 15 44 14 46"/>
                        </svg>
                    </div>

                    <p class="section-text contacts-intro">Náš svědek a svědkyně vám v den svatby rádi se vším pomohou a zodpoví všechny otázky.</p>
                    
                    <div class="contacts-grid">
                        {% for contact in contacts %}
                        <div class="contact-card">
                            <h3 class="contact-name">{{ contact.name }}</h3>
                            <p class="contact-role">{{ contact.role }}</p>
                            <a href="tel:{{ contact.phone | replace(' ', '') }}" class="btn btn--pill btn--contact">
                                Zavolat: {{ contact.phone }}
                            </a>
                        </div>
                        {% endfor %}
                    </div>
                </section>

                <div class="doodle-divider">
                    <svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor">
                        <path d="M2 6C12 2 16 10 26 6C31 4 35 7 38 6" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </div>

                {# ═══════════════════════════════════════════════ #}
                {# ODPOČET ČASU ("Uvidíme se za...")               #}
                {# ═══════════════════════════════════════════════ #}
                <section id="odpocet" class="section countdown-section">
                    <div class="countdown-frame">
                        <h2 class="countdown-title">Uvidíme se za...</h2>
                        <div id="countdown" class="countdown-grid" data-target="{{ wedding.datetime }}">
                            <div class="countdown-item">
                                <span class="countdown-num" id="cd-days">00</span>
                                <span class="countdown-label">Dní</span>
                            </div>
                            <div class="countdown-sep">:</div>
                            <div class="countdown-item">
                                <span class="countdown-num" id="cd-hours">00</span>
                                <span class="countdown-label">Hodin</span>
                            </div>
                            <div class="countdown-sep">:</div>
                            <div class="countdown-item">
                                <span class="countdown-num" id="cd-minutes">00</span>
                                <span class="countdown-label">Minut</span>
                            </div>
                            <div class="countdown-sep">:</div>
                            <div class="countdown-item">
                                <span class="countdown-num" id="cd-seconds">00</span>
                                <span class="countdown-label">Sekund</span>
                            </div>
                        </div>
                    </div>
                </section>

                {# ═══════════════════════════════════════════════ #}
                {# ZÁVĚR & KALENDÁŘ                               #}
                {# ═══════════════════════════════════════════════ #}
                <section class="section closing-section">
                    <div class="closing-heart">
                        <!-- Skica srdíčka s mašličkou -->
                        <svg width="72" height="72" viewBox="0 0 72 72" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M36 60C36 60 12 44 12 26C12 18 18 12 26 12C31 12 34 15 36 18C38 15 41 12 46 12C54 12 60 18 60 26C60 44 36 60 36 60Z"/>
                            <!-- Malá větvička / list uvnitř -->
                            <path d="M36 28C36 38 32 44 26 48"/>
                            <path d="M34 34C37 33 39 30 38 28"/>
                            <path d="M33 40C36 39 37 36 36 34"/>
                        </svg>
                    </div>

                    <h2 class="closing-title">S láskou, {{ couple.name_a }} &amp; {{ couple.name_b }}</h2>
                    <p class="closing-date">{{ wedding.date | czech_date }} · {{ venue.name }}</p>

                    <div class="closing-action">
                        <a href="{{ _ics_file }}" class="btn btn--pill btn--primary" download>
                            Uložit datum do kalendáře
                        </a>
                    </div>
                </section>

            </main>

            {# ═══════════════════════════════════════════════ #}
            {# FOOTER                                         #}
            {# ═══════════════════════════════════════════════ #}
            <footer class="footer">
                <p>{{ couple.name_a }} &amp; {{ couple.name_b }} 2027</p>
            </footer>

        </div><!-- /.invite-canvas -->
    </div><!-- /.page-container -->

    <script src="static/main.js"></script>
</body>
</html>
