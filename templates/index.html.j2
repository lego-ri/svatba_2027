<!DOCTYPE html>
<html lang="{{ wedding.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ site.title }}</title>
    <meta name="description" content="{{ site.meta_description }}">
    {% if privacy.robots_noindex %}
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet">
    {% endif %}

    <!-- Google Fonts: Pinyon Script & Alex Brush (Elegant cursive), Cormorant Garamond (Editorial serif), Plus Jakarta Sans (Clean modern text) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Pinyon+Script&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    {# ── Barevná paleta jako CSS proměnné ── #}
    <style>
        :root {
            --color-navy:           {{ colors.navy }};
            --color-blue-royal:     {{ colors.blue_royal }};
            --color-lemon:          {{ colors.lemon }};
            --color-lemon-dark:     {{ colors.lemon_dark }};
            --color-ivory:          {{ colors.ivory }};
            --color-leaf-green:     {{ colors.leaf_green }};
            --color-text-dark:      {{ colors.text_dark }};
            --color-text-muted:     {{ colors.text_muted }};
        }
    </style>
    <link rel="stylesheet" href="static/style.css?v={{ _build.timestamp | replace(':', '') | replace('-', '') | replace('.', '') }}">
</head>
<body>

    {# ═══════════════════════════════════════════════ #}
    {# 1. HERO SECTION                                 #}
    {# ═══════════════════════════════════════════════ #}
    <header id="uvod" class="hero-section">
        <div class="hero-container">
            
            <!-- Jména novomanželů nad panáčky v jednotném elegantním psacím stylu -->
            <h1 class="hero__names">{{ couple.name_a }} &amp; {{ couple.name_b }}</h1>

            <!-- Panáčci sedící vedle sebe, držící před obličejem tabulky 12 a 06 -->
            <div class="hero__couple-visual">
                <img src="static/images/lego-couple-hero.png" 
                     alt="Kačí &amp; Ričí — 12. 06. 2027" 
                     width="520" 
                     height="390" 
                     loading="eager" 
                     class="couple-img">
            </div>

            <!-- Datum a místo konání -->
            <div class="hero__meta">
                <span class="hero__date">{{ wedding.date | czech_date }}</span>
                <span class="hero__sep">·</span>
                <span class="hero__venue">{{ venue.name }}</span>
            </div>

            <p class="hero__invitation">
                Srdečně vás zveme, abyste s námi oslavili náš svatební den!
            </p>

            <!-- Jemný LEGO oddělovač s citronem -->
            <div class="lemon-divider" aria-hidden="true">
                <svg width="120" height="34" viewBox="0 0 120 34" fill="none">
                    <!-- Realistická větvička s citronem -->
                    <path d="M10 17H45" stroke="#102B50" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M75 17H110" stroke="#102B50" stroke-width="1.5" stroke-linecap="round"/>
                    <!-- List vlevo -->
                    <path d="M50 17C42 10 44 4 52 7C58 9 55 16 50 17Z" fill="#556B3A"/>
                    <!-- Skutečný tvar citronu se špičkami na koncích -->
                    <path d="M52 17C52 11 56 6 63 6C66 6 68 8 70 10C73 13 74 15 74 17C74 21 70 26 63 26C56 26 52 22 52 17Z" fill="#F5C928"/>
                    <path d="M50 17C51 16 52 16 53 17C52 18 51 18 50 17Z" fill="#D49A00"/>
                    <path d="M74 17C75 16 76 17 76 17.5C76 18 75 18 74 17Z" fill="#D49A00"/>
                    <!-- Malý květ citroníku -->
                    <circle cx="48" cy="12" r="2.5" fill="#FFFFFF"/>
                    <circle cx="48" cy="12" r="1" fill="#F5C928"/>
                </svg>
            </div>
        </div>
    </header>

    {# ═══════════════════════════════════════════════ #}
    {# 2. ČISTÁ STICKY NAVIGACE (BEZ RÁMEČKŮ)         #}
    {# ═══════════════════════════════════════════════ #}
    <nav id="nav" class="nav">
        <div class="nav-container">
            <ul class="nav-links">
                <li><a href="#dulezite">Přehled</a></li>
                <li><a href="#misto">Místo &amp; doprava</a></li>
                <li><a href="#program">Harmonogram</a></li>
                <li><a href="#dress-code">Dress code</a></li>
                <li><a href="#ubytovani">Ubytování &amp; dary</a></li>
                <li><a href="#upozorneni">Info</a></li>
                <li><a href="#kontakt">Kontakty</a></li>
            </ul>
        </div>
    </nav>

    <main>

        {# ═══════════════════════════════════════════════ #}
        {# 3. HLAVNÍ INFORMACE (BEZ RÁMEČKŮ)              #}
        {# ═══════════════════════════════════════════════ #}
        <section id="dulezite" class="section">
            <div class="container">
                <div class="open-columns-3">
                    
                    <!-- KDY -->
                    <div class="open-col">
                        <div class="col-lego-art">
                            <!-- LEGO kalendář kostička -->
                            <svg viewBox="0 0 60 54" width="54" height="48" fill="none">
                                <rect x="8" y="14" width="44" height="34" rx="3" fill="#102B50"/>
                                <!-- 4 LEGO piny na horní hraně -->
                                <circle cx="16" cy="10" r="3.5" fill="#3B72C5"/>
                                <circle cx="26" cy="10" r="3.5" fill="#3B72C5"/>
                                <circle cx="36" cy="10" r="3.5" fill="#3B72C5"/>
                                <circle cx="46" cy="10" r="3.5" fill="#3B72C5"/>
                                <rect x="14" y="22" width="32" height="20" rx="2" fill="#FFF8EC"/>
                                <text x="30" y="37" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="14" fill="#102B50" text-anchor="middle">12. 6.</text>
                            </svg>
                        </div>
                        <h2 class="col-title">Kdy?</h2>
                        <p class="col-highlight">{{ wedding.date | czech_date }}</p>
                        <p class="col-desc">Začátek obřadu ve {{ wedding.time }} hod.<br>Příjezd hostů od 12:00.</p>
                    </div>

                    <!-- KDE -->
                    <div class="open-col">
                        <div class="col-lego-art">
                            <!-- LEGO ukazatel Statek P22 -->
                            <svg viewBox="0 0 60 54" width="54" height="48" fill="none">
                                <rect x="14" y="16" width="32" height="32" rx="3" fill="#F5C928"/>
                                <circle cx="22" cy="12" r="3.5" fill="#D49A00"/>
                                <circle cx="38" cy="12" r="3.5" fill="#D49A00"/>
                                <path d="M10 20L30 6L50 20" stroke="#102B50" stroke-width="3" stroke-linecap="round"/>
                                <circle cx="30" cy="28" r="4.5" fill="#102B50"/>
                                <rect x="26" y="36" width="8" height="12" fill="#102B50"/>
                            </svg>
                        </div>
                        <h2 class="col-title">Kde?</h2>
                        <p class="col-highlight">{{ venue.name }}</p>
                        <p class="col-desc">{{ venue.description }}</p>
                        <div class="col-links">
                            <a href="{{ venue.maps.google }}" target="_blank" rel="noopener" class="link-text">Google Maps &rarr;</a>
                            <a href="{{ venue.maps.mapy_cz }}" target="_blank" rel="noopener" class="link-text">Mapy.cz &rarr;</a>
                        </div>
                    </div>

                    <!-- DRESS CODE SHRNUTÍ -->
                    <div class="open-col">
                        <div class="col-lego-art">
                            <!-- LEGO kostky modrá & žlutá -->
                            <svg viewBox="0 0 60 54" width="54" height="48" fill="none">
                                <rect x="10" y="24" width="22" height="24" rx="2" fill="#102B50"/>
                                <circle cx="16" cy="20" r="3.5" fill="#3B72C5"/>
                                <circle cx="26" cy="20" r="3.5" fill="#3B72C5"/>
                                <rect x="28" y="16" width="22" height="32" rx="2" fill="#F5C928"/>
                                <circle cx="34" cy="12" r="3.5" fill="#D49A00"/>
                                <circle cx="44" cy="12" r="3.5" fill="#D49A00"/>
                            </svg>
                        </div>
                        <h2 class="col-title">Barvy</h2>
                        <p class="col-highlight">Modrá &amp; Žlutá</p>
                        <p class="col-desc">Ponese se v nich výzdoba naší svatby.</p>
                        <a href="#dress-code" class="link-text">Doporučené odstíny &rarr;</a>
                    </div>

                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 4. MÍSTO & DOPRAVA                             #}
        {# ═══════════════════════════════════════════════ #}
        <section id="misto" class="section">
            <div class="container container--narrow">
                <div class="section-title-wrap">
                    <h2 class="section-heading">Statek P22</h2>
                    <p class="section-subtext">Obřad, odpolední raut i večerní oslava se odehrávají na jednom místě.</p>
                </div>

                <div class="nav-map-buttons">
                    <a href="{{ venue.maps.google }}" target="_blank" rel="noopener" class="btn btn--outline">
                        Otevřít v Google Maps
                    </a>
                    <a href="{{ venue.maps.mapy_cz }}" target="_blank" rel="noopener" class="btn btn--outline">
                        Otevřít v Mapy.cz
                    </a>
                </div>

                <div class="open-details-grid">
                    <div class="detail-block">
                        <div class="lego-mini-art">
                            <!-- LEGO auto pro dopravu -->
                            <svg viewBox="0 0 72 36" width="64" height="32" fill="none">
                                <rect x="8" y="12" width="56" height="15" rx="3" fill="#F5C928"/>
                                <path d="M22 12L30 3H48L56 12Z" fill="#102B50"/>
                                <rect x="32" y="6" width="14" height="6" fill="#FFF8EC"/>
                                <circle cx="20" cy="27" r="6" fill="#102B50"/>
                                <circle cx="20" cy="27" r="2.5" fill="#F5C928"/>
                                <circle cx="52" cy="27" r="6" fill="#102B50"/>
                                <circle cx="52" cy="27" r="2.5" fill="#F5C928"/>
                                <!-- LEGO piny nahoře na kapotě -->
                                <circle cx="14" cy="9" r="2.5" fill="#D49A00"/>
                                <circle cx="60" cy="9" r="2.5" fill="#D49A00"/>
                            </svg>
                        </div>
                        <h3 class="detail-heading">Doprava</h3>
                        <p class="detail-body">{{ transport.description }}</p>
                    </div>

                    <div class="detail-block">
                        <div class="lego-mini-art">
                            <!-- LEGO parkovací značka -->
                            <svg viewBox="0 0 50 36" width="44" height="32" fill="none">
                                <rect x="12" y="4" width="26" height="28" rx="3" fill="#3B72C5"/>
                                <text x="25" y="24" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="18" fill="#FFF8EC" text-anchor="middle">P</text>
                                <circle cx="25" cy="2" r="2.5" fill="#102B50"/>
                            </svg>
                        </div>
                        <h3 class="detail-heading">Parkování</h3>
                        <p class="detail-body">{{ parking.description }}</p>
                        <div class="detail-links">
                            <a href="{{ parking.maps.google }}" target="_blank" rel="noopener" class="link-text">Parkoviště — Google Maps &rarr;</a>
                            <a href="{{ parking.maps.mapy_cz }}" target="_blank" rel="noopener" class="link-text">Parkoviště — Mapy.cz &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 5. HARMONOGRAM (ZAPADAJÍCÍ LEGO KOSTIČKY)      #}
        {# ═══════════════════════════════════════════════ #}
        <section id="program" class="section">
            <div class="container container--narrow">
                <div class="section-title-wrap">
                    <h2 class="section-heading">Harmonogram</h2>
                    <p class="section-subtext">Jak do sebe poskládáme svatební den</p>
                </div>

                <!-- Sloupec do sebe zapadajících LEGO kostiček -->
                <div class="lego-interlocking-timeline">
                    {% for event in schedule %}
                    <div class="lego-brick-row lego-brick-row--{{ event.color }}">
                        
                        <!-- Vizuální LEGO kostka, která do sebe zapadá s další kostkou -->
                        <div class="brick-joint-visual">
                            <div class="brick-body">
                                <div class="brick-studs-top">
                                    <span class="stud"></span>
                                    <span class="stud"></span>
                                </div>
                                <div class="brick-core">
                                    <span class="brick-time">{{ event.time }}</span>
                                </div>
                                <div class="brick-connector-bottom"></div>
                            </div>
                        </div>

                        <!-- Text položky harmonogramu -->
                        <div class="brick-content">
                            <h3 class="brick-title">{{ event.title }}</h3>
                            {% if event.description %}
                            <p class="brick-desc">{{ event.description }}</p>
                            {% endif %}
                        </div>

                    </div>
                    {% endfor %}
                </div>

                <p class="timeline-note">Časy jsou orientační, budeme se řídit pohodou a letním dnem.</p>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 6. DRESS CODE (MODRÁ & ŽLUTÁ, BEZ RÁMEČKŮ)    #}
        {# ═══════════════════════════════════════════════ #}
        <section id="dress-code" class="section">
            <div class="container container--narrow">
                <div class="section-title-wrap">
                    <h2 class="section-heading">Dress code</h2>
                    
                    <!-- LEGO oblek & šaty z lega -->
                    <div class="lego-attire-art" aria-hidden="true">
                        <svg viewBox="0 0 120 70" width="110" height="65" fill="none">
                            <!-- LEGO ženich oblek vlevo -->
                            <rect x="18" y="18" width="34" height="42" rx="3" fill="#102B50"/>
                            <!-- LEGO piny u ramen -->
                            <circle cx="26" cy="14" r="3.5" fill="#3B72C5"/>
                            <circle cx="44" cy="14" r="3.5" fill="#3B72C5"/>
                            <!-- Bílá košile a žlutý motýlek -->
                            <path d="M30 18L35 28L40 18" fill="#FFF8EC"/>
                            <polygon points="32,23 38,27 38,23 32,27" fill="#F5C928"/>
                            <circle cx="35" cy="25" r="1.5" fill="#D49A00"/>
                            
                            <!-- LEGO nevěsta šaty vpravo -->
                            <path d="M72 20L84 18L96 20L104 60H64L72 20Z" fill="#FFF8EC" stroke="#102B50" stroke-width="1.5"/>
                            <circle cx="76" cy="14" r="3.5" fill="#F5C928"/>
                            <circle cx="92" cy="14" r="3.5" fill="#F5C928"/>
                            <!-- Žlutý pas / stuha -->
                            <rect x="71" y="32" width="26" height="4" fill="#F5C928"/>
                        </svg>
                    </div>

                    <p class="dress-code-prose">
                        {{ dress_code.description }}
                    </p>

                    <p class="dress-code-warning">
                        {{ dress_code.terrain_warning }}
                    </p>
                </div>

                <!-- Doporučené odstíny jako čisté LEGO destičky -->
                <div class="palette-grid">
                    {% for c in dress_code.palette %}
                    <div class="palette-item">
                        <div class="lego-swatch-brick" style="background-color: {{ c.hex }};">
                            <span class="swatch-stud-round"></span>
                            <span class="swatch-stud-round"></span>
                        </div>
                        <span class="palette-label">{{ c.name }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 7. UBYTOVÁNÍ & DARY (BEZ OHRANIČENÍ)           #}
        {# ═══════════════════════════════════════════════ #}
        <section id="ubytovani" class="section">
            <div class="container container--narrow">
                
                <!-- Ubytování: Stany & Penzion -->
                <div class="open-section-block">
                    <div class="lego-art-center" aria-hidden="true">
                        <!-- LEGO stan -->
                        <svg viewBox="0 0 90 60" width="80" height="54" fill="none">
                            <polygon points="15,50 45,14 75,50" fill="#F5C928"/>
                            <polygon points="45,14 75,50 85,50 55,14" fill="#D49A00"/>
                            <!-- Vstup do stanu -->
                            <polygon points="38,50 45,30 52,50" fill="#102B50"/>
                            <!-- LEGO piny nahoře na hřebeni stanu -->
                            <circle cx="45" cy="10" r="3.5" fill="#102B50"/>
                            <circle cx="53" cy="10" r="3.5" fill="#102B50"/>
                            <!-- Kolíky -->
                            <line x1="12" y1="50" x2="6" y2="54" stroke="#102B50" stroke-width="2"/>
                            <line x1="85" y1="50" x2="91" y2="54" stroke="#102B50" stroke-width="2"/>
                        </svg>
                    </div>

                    <h2 class="section-heading">Ubytování</h2>
                    <p class="open-prose">{{ accommodation.description }}</p>
                    <p class="open-subprose">{{ accommodation.pension_note }}</p>
                </div>

                <div class="subtle-divider" aria-hidden="true">
                    <span></span>
                </div>

                <!-- Svatební dary -->
                <div id="dary" class="open-section-block">
                    <div class="lego-art-center" aria-hidden="true">
                        <!-- LEGO dárková krabička -->
                        <svg viewBox="0 0 70 60" width="64" height="54" fill="none">
                            <rect x="15" y="24" width="40" height="28" rx="2" fill="#3B72C5"/>
                            <!-- Žlutá stuha -->
                            <rect x="31" y="24" width="8" height="28" fill="#F5C928"/>
                            <rect x="15" y="34" width="40" height="7" fill="#F5C928"/>
                            <!-- Víko krabičky -->
                            <rect x="11" y="18" width="48" height="8" rx="1" fill="#102B50"/>
                            <!-- LEGO piny nahoře -->
                            <circle cx="26" cy="14" r="3.5" fill="#F5C928"/>
                            <circle cx="44" cy="14" r="3.5" fill="#F5C928"/>
                            <!-- Mašlička -->
                            <path d="M35 18C30 11 23 13 28 17C31 18 35 18 35 18Z" fill="#F5C928"/>
                            <path d="M35 18C40 11 47 13 42 17C39 18 35 18 35 18Z" fill="#F5C928"/>
                        </svg>
                    </div>

                    <h2 class="section-heading">Svatební dary</h2>
                    <p class="open-prose">{{ gifts.description }}</p>
                </div>

            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 8. ABY VÁS NIC NEPŘEKVAPILO (BEZ RÁMEČKŮ)      #}
        {# ═══════════════════════════════════════════════ #}
        <section id="upozorneni" class="section">
            <div class="container container--narrow">
                <div class="section-title-wrap">
                    <div class="lego-art-center" aria-hidden="true">
                        <!-- LEGO deštník / počasí -->
                        <svg viewBox="0 0 70 54" width="60" height="46" fill="none">
                            <path d="M12 30C12 17 22 10 35 10C48 10 58 17 58 30H12Z" fill="#F5C928"/>
                            <circle cx="35" cy="7" r="3" fill="#102B50"/>
                            <path d="M35 30V44C35 47 32 48 30 46" stroke="#102B50" stroke-width="2.5" stroke-linecap="round"/>
                            <!-- Kapky jako modré LEGO dílky -->
                            <rect x="18" y="38" width="4" height="6" rx="2" fill="#3B72C5"/>
                            <rect x="48" y="38" width="4" height="6" rx="2" fill="#3B72C5"/>
                        </svg>
                    </div>
                    <h2 class="section-heading">{{ surprises.title }}</h2>
                </div>

                <div class="surprises-open-list">
                    {% for item in surprises.entries %}
                    <div class="surprise-open-row">
                        <span class="surprise-bullet-brick"></span>
                        <div class="surprise-text">
                            <h3>{{ item.title }}</h3>
                            <p>{{ item.description }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 9. KONTAKTY NA DEN D                           #}
        {# ═══════════════════════════════════════════════ #}
        <section id="kontakt" class="section">
            <div class="container container--narrow">
                <div class="section-title-wrap">
                    <h2 class="section-heading">Kontakty</h2>
                    <p class="section-subtext">
                        V den svatby nechte novomanžele slavit a v případě dotazů se obracejte na naše skvělé svědky:
                    </p>
                </div>

                <div class="contacts-open-grid">
                    {% for contact in contacts %}
                    <div class="contact-open-item">
                        <span class="contact-stud-icon"></span>
                        <h3 class="contact-person-name">{{ contact.name }}</h3>
                        <span class="contact-person-role">{{ contact.role }}</span>
                        <a href="tel:{{ contact.phone | replace(' ', '') }}" class="btn btn--phone">
                            Zavolat: {{ contact.phone }}
                        </a>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 10. ŽIVÝ ODPOČET ČASU                          #}
        {# ═══════════════════════════════════════════════ #}
        <section id="odpocet" class="section countdown-clean-section">
            <div class="container container--narrow">
                <p class="countdown-pretitle">Uvidíme se za...</p>
                
                <div id="countdown" class="countdown-open-grid" data-target="{{ wedding.datetime }}">
                    <div class="cd-item">
                        <span class="cd-number" id="cd-days">00</span>
                        <span class="cd-title">Dní</span>
                    </div>
                    <span class="cd-sep">:</span>
                    <div class="cd-item">
                        <span class="cd-number" id="cd-hours">00</span>
                        <span class="cd-title">Hodin</span>
                    </div>
                    <span class="cd-sep">:</span>
                    <div class="cd-item">
                        <span class="cd-number" id="cd-minutes">00</span>
                        <span class="cd-title">Minut</span>
                    </div>
                    <span class="cd-sep">:</span>
                    <div class="cd-item">
                        <span class="cd-number" id="cd-seconds">00</span>
                        <span class="cd-title">Sekund</span>
                    </div>
                </div>
            </div>
        </section>

    </main>

    {# ═══════════════════════════════════════════════ #}
    {# 11. ZÁVĚR & PATIČKA (SRDÍČKO PŘED OBLIČEJEM)   #}
    {# ═══════════════════════════════════════════════ #}
    <footer class="closing-footer">
        <div class="container container--narrow">
            
            <!-- Panáčci sedící vedle sebe, držící společně srdíčko před obličejem: "Těšíme se na vás 12.6.2027" -->
            <div class="closing__couple-visual">
                <img src="static/images/lego-couple-heart.png" 
                     alt="Těšíme se na vás — 12. 6. 2027" 
                     width="480" 
                     height="360" 
                     loading="lazy" 
                     class="couple-heart-img">
            </div>

            <div class="closing__calendar-box">
                <a href="{{ _ics_file }}" class="btn btn--save-calendar" download>
                    Uložit datum 12. 6. 2027 do kalendáře (.ics)
                </a>
            </div>

            <div class="footer-names-line">
                <p class="script-footer-names">{{ couple.name_a }} &amp; {{ couple.name_b }}</p>
                <p class="footer-sub-text">{{ wedding.date | czech_date }} · {{ venue.name }}</p>
            </div>
        </div>
    </footer>

    <script src="static/main.js"></script>
</body>
</html>
