<!DOCTYPE html>
<html lang="{{ wedding.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ site.title }}</title>
    <meta name="description" content="{{ site.meta_description }}">
    {% if privacy.robots_noindex %}
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet">
    {% endif %}

    <!-- Google Fonts: Cormorant Garamond (Editorial serif), Plus Jakarta Sans (Clean modern UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    {# ── Barevná paleta jako CSS proměnné ── #}
    <style>
        :root {
            --color-navy:           {{ colors.navy }};
            --color-blue-royal:     {{ colors.blue_royal }};
            --color-lemon:          {{ colors.lemon }};
            --color-lemon-dark:     {{ colors.lemon_dark }};
            --color-ivory:          {{ colors.ivory }};
            --color-leaf-green:     {{ colors.leaf_green }};
            --color-text-dark:      {{ colors.text_dark }};
            --color-text-muted:     {{ colors.text_muted }};
        }
    </style>
    <link rel="stylesheet" href="static/style.css?v={{ _build.timestamp | replace(':', '') | replace('-', '') | replace('.', '') }}">
</head>
<body>

    {# ═══════════════════════════════════════════════ #}
    {# 1. HERO SECTION                                 #}
    {# ═══════════════════════════════════════════════ #}
    <header id="uvod" class="hero-section">
        <div class="hero-container">
            
            <!-- Jména novomanželů prohnutá do půlkruhu (malinko větší) -->
            <div class="hero-arch-wrap">
                <svg class="hero-arch-svg" viewBox="0 0 660 145" aria-label="{{ couple.name_a }} &amp; {{ couple.name_b }}">
                    <defs>
                        <path id="archPath" d="M 25,125 Q 330,10 635,125" fill="none" />
                    </defs>
                    <text class="arch-heading-text">
                        <textPath href="#archPath" startOffset="50%" text-anchor="middle">
                            {{ couple.name_a }} &amp; {{ couple.name_b }}
                        </textPath>
                    </text>
                </svg>
            </div>

            <!-- Panáčci sedící vedle sebe – LEGO Botanicals 10313 kytičky a citrony (transparentní PNG) -->
            <div class="hero__couple-visual">
                <img src="static/images/lego-couple-hero.png" 
                     alt="Kačí &amp; Ričí — 12. 06. 2027" 
                     width="520" 
                     height="390" 
                     loading="eager" 
                     class="couple-img">
            </div>

            <!-- Sekce "Uvidíme se za..." pod obrázkem -->
            <div class="hero-countdown-block">
                <p class="countdown-pretitle">Uvidíme se za</p>
                <div id="countdown" class="countdown-open-grid" data-target="{{ wedding.datetime }}">
                    <div class="cd-item">
                        <span class="cd-number" id="cd-days">00</span>
                        <span class="cd-title">Dní</span>
                    </div>
                    <span class="cd-sep">:</span>
                    <div class="cd-item">
                        <span class="cd-number" id="cd-hours">00</span>
                        <span class="cd-title">Hodin</span>
                    </div>
                    <span class="cd-sep">:</span>
                    <div class="cd-item">
                        <span class="cd-number" id="cd-minutes">00</span>
                        <span class="cd-title">Minut</span>
                    </div>
                    <span class="cd-sep">:</span>
                    <div class="cd-item">
                        <span class="cd-number" id="cd-seconds">00</span>
                        <span class="cd-title">Sekund</span>
                    </div>
                </div>
            </div>

            <!-- Datum a místo konání -->
            <div class="hero__meta">
                <span class="hero__date">{{ wedding.date | czech_date }}</span>
                <span class="hero__sep">·</span>
                <span class="hero__venue">{{ venue.name }}</span>
            </div>

            <p class="hero__invitation">
                Srdečně vás zveme, abyste s námi oslavili náš svatební den!
            </p>

            <!-- Realistický citronový předěl -->
            <div class="lemon-divider" aria-hidden="true">
                <svg width="130" height="36" viewBox="0 0 130 36" fill="none">
                    <path d="M10 18H46" stroke="#102B50" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M84 18H120" stroke="#102B50" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M52 18C44 9 46 3 55 6C62 9 58 17 52 18Z" fill="#4B602D"/>
                    <path d="M51 14C55 10 57 9 60 8" stroke="#688242" stroke-width="1" stroke-linecap="round"/>
                    <path d="M48 18C46 17 45 16 44 16C45 15 46 15 48 14C52 8 60 4 70 4C80 4 88 8 92 14C94 15 95 15 96 16C95 17 94 17 92 18C88 24 80 28 70 28C60 28 52 24 48 18Z" fill="#F5C928"/>
                    <path d="M47 16C46 15 45 15 44 16" stroke="#D49A00" stroke-width="1.2"/>
                    <path d="M93 16C94 15 95 15 96 16" stroke="#D49A00" stroke-width="1.2"/>
                    <circle cx="50" cy="11" r="2.5" fill="#FFFFFF"/>
                    <circle cx="50" cy="11" r="1" fill="#F5C928"/>
                </svg>
            </div>
        </div>
    </header>

    {# ═══════════════════════════════════════════════ #}
    {# 2. STICKY NAVIGACE (TVAR LEGO KOSTIČKY, ZMODRÁ)#}
    {# ═══════════════════════════════════════════════ #}
    <nav id="nav" class="nav">
        <div class="nav-container">
            <ul class="nav-links">
                <li><a href="#dulezite">Přehled</a></li>
                <li><a href="#misto">Místo &amp; doprava</a></li>
                <li><a href="#program">Harmonogram</a></li>
                <li><a href="#dress-code">Dress code</a></li>
                <li><a href="#ubytovani">Ubytování &amp; dary</a></li>
                <li><a href="#upozorneni">Info</a></li>
                <li><a href="#kontakt">Kontakty</a></li>
            </ul>
        </div>
    </nav>

    <main>

        {# ═══════════════════════════════════════════════ #}
        {# 3. HLAVNÍ INFORMACE (KDY, KDE, BARVY V LINII)  #}
        {# ═══════════════════════════════════════════════ #}
        <section id="dulezite" class="section">
            <div class="container">
                <div class="open-columns-3">
                    
                    <!-- KDY: Kalendář června se zvýrazněným dnem 12.6. ve stejné velikosti -->
                    <div class="open-col">
                        <div class="col-lego-art">
                            <svg viewBox="0 0 60 54" width="54" height="48" fill="none">
                                <!-- Podklad kalendáře -->
                                <rect x="8" y="10" width="44" height="40" rx="3" fill="#FFFFFF" stroke="#102B50" stroke-width="2"/>
                                <!-- Horní lišta s měsícem ČERVEN -->
                                <rect x="8" y="10" width="44" height="12" rx="2" fill="#102B50"/>
                                <text x="30" y="19" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="7.5" fill="#F5C928" text-anchor="middle" letter-spacing="1">ČERVEN</text>
                                <!-- LEGO piny na horní hraně kalendáře -->
                                <circle cx="18" cy="7" r="2.5" fill="#102B50"/>
                                <circle cx="42" cy="7" r="2.5" fill="#102B50"/>
                                <!-- Mřížka dnů -->
                                <circle cx="16" cy="28" r="1.5" fill="#102B50" opacity="0.4"/>
                                <circle cx="23" cy="28" r="1.5" fill="#102B50" opacity="0.4"/>
                                <circle cx="30" cy="28" r="1.5" fill="#102B50" opacity="0.4"/>
                                <circle cx="37" cy="28" r="1.5" fill="#102B50" opacity="0.4"/>
                                <circle cx="44" cy="28" r="1.5" fill="#102B50" opacity="0.4"/>
                                <!-- Zvýrazněný den 12.6. žlutou LEGO destičkou -->
                                <circle cx="16" cy="37" r="1.5" fill="#102B50" opacity="0.4"/>
                                <circle cx="23" cy="37" r="1.5" fill="#102B50" opacity="0.4"/>
                                <rect x="26.5" y="32" width="13" height="10" rx="2" fill="#F5C928"/>
                                <text x="33" y="39.5" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="7" fill="#102B50" text-anchor="middle">12</text>
                                <circle cx="44" cy="37" r="1.5" fill="#102B50" opacity="0.4"/>
                            </svg>
                        </div>
                        <h2 class="col-title">Kdy?</h2>
                        <p class="col-highlight">{{ wedding.date | czech_date }}</p>
                        <p class="col-desc">Začátek obřadu ve {{ wedding.time }} hod.<br>Příjezd hostů od 12:00.</p>
                    </div>

                    <!-- KDE: Bez odkazů a bez pomlčky podle požadavku -->
                    <div class="open-col">
                        <div class="col-lego-art">
                            <svg viewBox="0 0 60 54" width="54" height="48" fill="none">
                                <rect x="14" y="16" width="32" height="32" rx="3" fill="#F5C928"/>
                                <circle cx="22" cy="12" r="3.5" fill="#D49A00"/>
                                <circle cx="38" cy="12" r="3.5" fill="#D49A00"/>
                                <path d="M10 20L30 6L50 20" stroke="#102B50" stroke-width="3" stroke-linecap="round"/>
                                <circle cx="30" cy="28" r="4.5" fill="#102B50"/>
                                <rect x="26" y="36" width="8" height="12" fill="#102B50"/>
                            </svg>
                        </div>
                        <h2 class="col-title">Kde?</h2>
                        <p class="col-highlight">{{ venue.name }}</p>
                        <p class="col-desc">{{ venue.description }}</p>
                    </div>

                    <!-- BARVY: Shodná výška a linie -->
                    <div class="open-col">
                        <div class="col-lego-art">
                            <svg viewBox="0 0 60 54" width="54" height="48" fill="none">
                                <rect x="10" y="24" width="22" height="24" rx="2" fill="#102B50"/>
                                <circle cx="16" cy="20" r="3.5" fill="#3B72C5"/>
                                <circle cx="26" cy="20" r="3.5" fill="#3B72C5"/>
                                <rect x="28" y="16" width="22" height="32" rx="2" fill="#F5C928"/>
                                <circle cx="34" cy="12" r="3.5" fill="#D49A00"/>
                                <circle cx="44" cy="12" r="3.5" fill="#D49A00"/>
                            </svg>
                        </div>
                        <h2 class="col-title">Barvy</h2>
                        <p class="col-highlight">Modrá &amp; Žlutá</p>
                        <p class="col-desc">Ponese se v nich výzdoba naší svatby.</p>
                        <a href="#dress-code" class="link-text">Doporučené odstíny &rarr;</a>
                    </div>

                </div>

                <!-- Čára oddělující tento oddíl -->
                <div class="section-divider-line" aria-hidden="true"></div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 4. MÍSTO & DOPRAVA (SICILSKÉ SVISLÉ ŽLUTÉ PRUHY)#}
        {# ═══════════════════════════════════════════════ #}
        <section id="misto" class="section section--italian-vertical-stripes">
            <div class="container container--narrow">
                <div class="stripes-content-panel">
                    <div class="section-title-wrap">
                        <h2 class="section-heading">Statek P22</h2>
                        <!-- Věta o obřadu na jednom místě smazána, aby se neopakovala -->
                    </div>

                    <div class="nav-map-buttons">
                        <a href="{{ venue.maps.google }}" target="_blank" rel="noopener" class="btn btn--outline">
                            Otevřít v Google Maps
                        </a>
                        <a href="{{ venue.maps.mapy_cz }}" target="_blank" rel="noopener" class="btn btn--outline">
                            Otevřít v Mapy.cz
                        </a>
                    </div>

                    <div class="open-details-grid">
                        <div class="detail-block">
                            <h3 class="detail-heading">Doprava</h3>
                            <p class="detail-body">{{ transport.description }}</p>
                        </div>

                        <div class="detail-block">
                            <h3 class="detail-heading">Parkování</h3>
                            <p class="detail-body">{{ parking.description }}</p>
                            <div class="detail-links">
                                <a href="{{ parking.maps.google }}" target="_blank" rel="noopener" class="link-text">Parkoviště — Google Maps &rarr;</a>
                                <a href="{{ parking.maps.mapy_cz }}" target="_blank" rel="noopener" class="link-text">Parkoviště — Mapy.cz &rarr;</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 5. HARMONOGRAM (TEXT PŘÍMO NA STOLE)           #}
        {# ═══════════════════════════════════════════════ #}
        <section id="program" class="section">
            <div class="container container--narrow">
                <div class="section-title-wrap">
                    <h2 class="section-heading">Harmonogram</h2>
                </div>

                <!-- Svatební tabule: prázdný obdélníkový stůl, podél sedí legopanáčci, text harmonogramu na stole -->
                <div class="table-banquet-wrapper">
                    <img src="static/images/lego-timeline-table.png" 
                         alt="Svatební stůl s legopanáčky podél stolu a harmonogramem" 
                         width="520" 
                         height="696" 
                         loading="lazy" 
                         class="table-banquet-img">

                    <!-- Text harmonogramu umístěný přímo na desku / běhoun stolu (pouze čas a název) -->
                    <div class="table-surface-schedule">
                        {% for item in schedule %}
                        <div class="table-schedule-entry">
                            <span class="table-schedule-time">{{ item.time }}</span>
                            <h3 class="table-schedule-title">{{ item.title }}</h3>
                        </div>
                        {% if not loop.last %}
                        <div class="table-schedule-line" aria-hidden="true"></div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 6. DRESS CODE (VROUBKOVANÝ ZELENÝ RÁMEČEK)      #}
        {# ═══════════════════════════════════════════════ #}
        <section id="dress-code" class="section">
            <div class="container container--narrow">
                
                <!-- Jemný ručně kreslený vroubkovaný rámeček v tmavě zelené lince s botanickými detaily -->
                <div class="hand-drawn-scalloped-box">
                    <svg class="hand-drawn-frame-svg" viewBox="0 0 640 490" preserveAspectRatio="none" aria-hidden="true">
                        <filter id="softGlow" x="-5%" y="-5%" width="110%" height="110%">
                            <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#4B602D" flood-opacity="0.06"/>
                        </filter>
                        <!-- Pozadí: teplá slonová kost / smetanová s jemnou tmavě zelenou linkou -->
                        <path d="M 24.0,16.0 Q 47.6,9.0 71.3,16.0 Q 98.9,10.4 126.5,16.0 Q 154.2,9.9 181.8,16.0 Q 209.5,10.0 237.1,16.0 Q 264.7,8.8 292.4,16.0 Q 320.0,8.9 347.6,16.0 Q 375.3,8.4 402.9,16.0 Q 430.5,10.3 458.2,16.0 Q 485.8,9.5 513.5,16.0 Q 541.1,10.4 568.7,16.0 Q 592.4,10.0 616.0,16.0 Q 628.0,14.0 624.0,24.0 Q 630.7,45.4 624.0,66.9 Q 629.6,92.3 624.0,117.8 Q 630.0,143.2 624.0,168.7 Q 631.0,194.1 624.0,219.6 Q 630.8,245.0 624.0,270.4 Q 630.0,295.9 624.0,321.3 Q 630.9,346.8 624.0,372.2 Q 631.4,397.7 624.0,423.1 Q 629.5,444.6 624.0,466.0 Q 628.0,478.0 616.0,474.0 Q 592.4,481.4 568.7,474.0 Q 541.1,481.1 513.5,474.0 Q 485.8,480.3 458.2,474.0 Q 430.5,479.9 402.9,474.0 Q 375.3,481.7 347.6,474.0 Q 320.0,480.3 292.4,474.0 Q 264.7,479.7 237.1,474.0 Q 209.5,479.7 181.8,474.0 Q 154.2,481.4 126.5,474.0 Q 98.9,480.9 71.3,474.0 Q 47.6,481.4 24.0,474.0 Q 12.0,478.0 16.0,466.0 Q 8.8,444.6 16.0,423.1 Q 9.3,397.7 16.0,372.2 Q 8.3,346.8 16.0,321.3 Q 9.6,295.9 16.0,270.4 Q 9.2,245.0 16.0,219.6 Q 8.6,194.1 16.0,168.7 Q 9.1,143.2 16.0,117.8 Q 8.5,92.3 16.0,66.9 Q 9.2,45.4 16.0,24.0 Q 12.0,14.0 24.0,16.0 Z" 
                              fill="#FFFDF8" 
                              stroke="#4B602D" 
                              stroke-width="1.6" 
                              stroke-linecap="round" 
                              stroke-linejoin="round"
                              filter="url(#softGlow)"/>
                        
                        <!-- Jemné botanické lístky / doodle v rozích -->
                        <!-- Horní levý roh -->
                        <path d="M 28 28 C 34 20 42 22 46 26 C 42 30 36 32 28 28 Z" fill="#66794D" opacity="0.4"/>
                        <path d="M 27 29 C 32 24 38 24 44 26" stroke="#4B602D" stroke-width="1.1" stroke-linecap="round"/>
                        <path d="M 32 36 C 36 30 44 32 46 36 C 42 38 36 39 32 36 Z" fill="#66794D" opacity="0.3"/>
                        <!-- Horní pravý roh -->
                        <path d="M 612 28 C 606 20 598 22 594 26 C 598 30 604 32 612 28 Z" fill="#66794D" opacity="0.4"/>
                        <path d="M 613 29 C 608 24 602 24 596 26" stroke="#4B602D" stroke-width="1.1" stroke-linecap="round"/>
                        <path d="M 608 36 C 604 30 596 32 594 36 C 598 38 604 39 608 36 Z" fill="#66794D" opacity="0.3"/>
                        <!-- Dolní levý roh -->
                        <path d="M 28 462 C 34 470 42 468 46 464 C 42 460 36 458 28 462 Z" fill="#66794D" opacity="0.4"/>
                        <path d="M 27 461 C 32 466 38 466 44 464" stroke="#4B602D" stroke-width="1.1" stroke-linecap="round"/>
                        <!-- Dolní pravý roh -->
                        <path d="M 612 462 C 606 470 598 468 594 464 C 598 460 604 458 612 462 Z" fill="#66794D" opacity="0.4"/>
                        <path d="M 613 461 C 608 466 602 466 596 464" stroke="#4B602D" stroke-width="1.1" stroke-linecap="round"/>
                    </svg>

                    <!-- Text i paleta jsou uvnitř rámečku -->
                    <div class="hand-drawn-content">
                        <!-- Skutečný, realistický citron nad Dress code -->
                        <div class="realistic-lemon-header" aria-hidden="true">
                            <svg viewBox="0 0 80 50" width="70" height="44" fill="none">
                                <path d="M22 18C14 8 24 3 36 6C46 9 42 22 32 20Z" fill="#4B602D"/>
                                <path d="M25 15C31 11 35 10 39 9" stroke="#688242" stroke-width="1.3" stroke-linecap="round"/>
                                <path d="M10 28C7 26 5 25 4 25C5 24 7 24 10 22C15 15 26 9 42 9C58 9 69 15 74 22C77 24 78 24 79 25C78 26 77 26 74 28C69 35 58 41 42 41C26 41 15 35 10 28Z" fill="#F5C928"/>
                                <path d="M9 25C7 24 6 24 5 25" stroke="#D49A00" stroke-width="1.5"/>
                                <path d="M75 25C76 24 77 24 78 25" stroke="#D49A00" stroke-width="1.5"/>
                                <path d="M7 23L3 21" stroke="#4B602D" stroke-width="2.5" stroke-linecap="round"/>
                            </svg>
                        </div>

                        <h2 class="section-heading">Dress code</h2>

                        <p class="dress-code-prose">
                            {{ dress_code.description }}
                        </p>

                        <p class="dress-code-warning">
                            {{ dress_code.terrain_warning }}
                        </p>

                        <!-- Paleta: LEGO kostičky s 8 ťuflíky (2x4 brick) uvnitř rámečku -->
                        <div class="palette-grid">
                            {% for c in dress_code.palette %}
                            <div class="palette-item">
                                <div class="lego-brick-8stud" style="background-color: {{ c.hex }};">
                                    <div class="stud-row">
                                        <span class="stud-8"></span>
                                        <span class="stud-8"></span>
                                        <span class="stud-8"></span>
                                        <span class="stud-8"></span>
                                    </div>
                                    <div class="stud-row">
                                        <span class="stud-8"></span>
                                        <span class="stud-8"></span>
                                        <span class="stud-8"></span>
                                        <span class="stud-8"></span>
                                    </div>
                                </div>
                                <span class="palette-label">{{ c.name }}</span>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 7. UBYTOVÁNÍ (SICILSKÝ MOZAIKOVÝ PODKLAD)       #}
        {# ═══════════════════════════════════════════════ #}
        <section id="ubytovani" class="section section--sicilian-mosaic">
            <div class="container container--narrow">
                <div class="mosaic-content-panel">
                    
                    <!-- Ubytování -->
                    <div class="open-section-block">
                        <div class="lego-art-center" aria-hidden="true">
                            <svg viewBox="0 0 90 60" width="80" height="54" fill="none">
                                <polygon points="15,50 45,14 75,50" fill="#F5C928"/>
                                <polygon points="45,14 75,50 85,50 55,14" fill="#D49A00"/>
                                <polygon points="38,50 45,30 52,50" fill="#102B50"/>
                                <circle cx="45" cy="10" r="3.5" fill="#102B50"/>
                                <circle cx="53" cy="10" r="3.5" fill="#102B50"/>
                                <line x1="12" y1="50" x2="6" y2="54" stroke="#102B50" stroke-width="2"/>
                                <line x1="85" y1="50" x2="91" y2="54" stroke="#102B50" stroke-width="2"/>
                            </svg>
                        </div>

                        <h2 class="section-heading">Ubytování</h2>
                        <p class="open-prose">{{ accommodation.description }}</p>
                        <p class="open-subprose">{{ accommodation.pension_note }}</p>
                    </div>

                    <div class="subtle-divider" aria-hidden="true">
                        <span></span>
                    </div>

                    <!-- Svatební dary: LEGO kytky z Botanicals kolekce -->
                    <div id="dary" class="open-section-block">
                        <div class="lego-art-center" aria-hidden="true">
                            <img src="static/images/lego-botanicals-gifts.png" 
                                 alt="LEGO Botanicals květiny" 
                                 width="180" 
                                 height="180" 
                                 loading="lazy" 
                                 class="botanicals-gifts-img">
                        </div>

                        <h2 class="section-heading">Svatební dary</h2>
                        <p class="open-prose">{{ gifts.description }}</p>
                    </div>

                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 8. ABY VÁS NIC NEPŘEKVAPILO (LEGO PANÁČCI)    #}
        {# ═══════════════════════════════════════════════ #}
        <section id="upozorneni" class="section">
            <div class="container container--narrow">
                <div class="section-title-wrap">
                    <h2 class="section-heading">{{ surprises.title }}</h2>
                </div>

                <div class="surprises-open-list">
                    {% for item in surprises.entries %}
                    <div class="surprise-open-row">
                        <!-- LEGO panáčci jako odrážky: 1. holka s hnědými vlasy, 2. kluk s blonďatými, 3. úplně jiný -->
                        <span class="minifig-bullet-icon" aria-hidden="true">
                            {% set icon_variant = loop.cycle(1, 2, 3) %}
                            {% if icon_variant == 1 %}
                            <!-- 1. Holka s hnědými vlasy -->
                            <svg viewBox="0 0 32 32" width="30" height="30" fill="none">
                                <!-- LEGO žlutá hlava -->
                                <rect x="6.5" y="7" width="19" height="17" rx="4.5" fill="#F5C928" stroke="#D49A00" stroke-width="0.9"/>
                                <!-- Oči a úsměv -->
                                <circle cx="12" cy="16.5" r="1.3" fill="#102B50"/>
                                <circle cx="20" cy="16.5" r="1.3" fill="#102B50"/>
                                <path d="M10.8 15.2 L12 15.8" stroke="#102B50" stroke-width="0.8" stroke-linecap="round"/>
                                <path d="M21.2 15.2 L20 15.8" stroke="#102B50" stroke-width="0.8" stroke-linecap="round"/>
                                <path d="M12.5 19.5 Q16 22.5 19.5 19.5" stroke="#102B50" stroke-width="1.2" stroke-linecap="round" fill="none"/>
                                <!-- Hnědé vlasy -->
                                <path d="M6 12 C6 5.5 10.5 2.5 16 2.5 C21.5 2.5 26 5.5 26 12 C26 17.5 24 20.5 24 20.5 C23 15 20.5 10.5 16 10.5 C11.5 10.5 9 15 8 20.5 C8 20.5 6 17.5 6 12 Z" fill="#4E2A14"/>
                                <path d="M6.5 12.5 Q5.5 18 7.5 21.5" stroke="#3D200E" stroke-width="1.5" stroke-linecap="round"/>
                                <path d="M25.5 12.5 Q26.5 18 24.5 21.5" stroke="#3D200E" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            {% elif icon_variant == 2 %}
                            <!-- 2. Kluk s blonďatými vlasy -->
                            <svg viewBox="0 0 32 32" width="30" height="30" fill="none">
                                <!-- LEGO žlutá hlava -->
                                <rect x="6.5" y="7" width="19" height="17" rx="4.5" fill="#F5C928" stroke="#D49A00" stroke-width="0.9"/>
                                <!-- Oči a úsměv -->
                                <circle cx="12" cy="16.5" r="1.3" fill="#102B50"/>
                                <circle cx="20" cy="16.5" r="1.3" fill="#102B50"/>
                                <path d="M12.5 19.5 Q16 22.5 19.5 19.5" stroke="#102B50" stroke-width="1.2" stroke-linecap="round" fill="none"/>
                                <!-- Blonďaté vlasy s patkou -->
                                <path d="M5.5 11 C5.5 5 10 2.5 16 2.5 C22 2.5 26.5 5 26.5 11 C24.5 10 22 8 19 8.5 C16 8 13.5 8.5 11 10.5 C8.5 9.5 6.5 10.5 5.5 11 Z" fill="#F5D258"/>
                                <path d="M6 10 Q11 6.5 18 6.5 Q23 6 26 9.5" stroke="#D4AB25" stroke-width="1" fill="none"/>
                            </svg>
                            {% else %}
                            <!-- 3. Třetí úplně jiný: zrzavé kudrnaté vlasy a brýle -->
                            <svg viewBox="0 0 32 32" width="30" height="30" fill="none">
                                <!-- LEGO žlutá hlava -->
                                <rect x="6.5" y="7" width="19" height="17" rx="4.5" fill="#F5C928" stroke="#D49A00" stroke-width="0.9"/>
                                <!-- Stylové kulaté brýle a oči -->
                                <circle cx="12" cy="16.5" r="3" stroke="#102B50" stroke-width="1.2" fill="rgba(255,255,255,0.3)"/>
                                <circle cx="20" cy="16.5" r="3" stroke="#102B50" stroke-width="1.2" fill="rgba(255,255,255,0.3)"/>
                                <line x1="15" y1="16.5" x2="17" y2="16.5" stroke="#102B50" stroke-width="1.2"/>
                                <circle cx="12" cy="16.5" r="1.1" fill="#102B50"/>
                                <circle cx="20" cy="16.5" r="1.1" fill="#102B50"/>
                                <path d="M13 21 Q16 23.5 19 21" stroke="#102B50" stroke-width="1.2" stroke-linecap="round" fill="none"/>
                                <!-- Zrzavé kudrnaté vlasy -->
                                <path d="M6 11 C4.5 9 5 5 8 4 C10 2 13 2.5 16 2.5 C19 2.5 22 2 24 4 C27 5 27.5 9 26 11 C24 10.5 23 8.5 20 9 C18 8 14 8 12 9 C9 8.5 8 10.5 6 11 Z" fill="#C6531D"/>
                                <circle cx="7.5" cy="8" r="2.5" fill="#C6531D"/>
                                <circle cx="24.5" cy="8" r="2.5" fill="#C6531D"/>
                                <circle cx="16" cy="4" r="2.5" fill="#D4652A"/>
                            </svg>
                            {% endif %}
                        </span>
                        <div class="surprise-text">
                            <h3>{{ item.title }}</h3>
                            <p>{{ item.description }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ═══════════════════════════════════════════════ #}
        {# 9. KONTAKTY NA DEN D                           #}
        {# ═══════════════════════════════════════════════ #}
        <section id="kontakt" class="section">
            <div class="container container--narrow">
                <div class="section-title-wrap">
                    <h2 class="section-heading">Kontakty</h2>
                    <p class="section-subtext">
                        V případě jakýchkoliv dotazů se neváhejte obrátit přímo na nás:
                    </p>
                </div>

                <div class="contacts-open-grid">
                    {% for contact in contacts %}
                    <div class="contact-open-item">
                        <span class="contact-stud-icon"></span>
                        <h3 class="contact-person-name">{{ contact.name }}</h3>
                        <span class="contact-person-role">{{ contact.role }}</span>
                        <a href="tel:{{ contact.phone | replace(' ', '') }}" class="btn btn--phone">
                            Zavolat: {{ contact.phone }}
                        </a>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>

    </main>

    {# ═══════════════════════════════════════════════ #}
    {# 10. ZÁVĚR & PATIČKA (SRDCE NENÍ ČERVENÉ)       #}
    {# ═══════════════════════════════════════════════ #}
    <footer class="closing-footer">
        <div class="container container--narrow">
            
            <!-- Panáčci sedící vedle sebe, držící žluto-zlaté srdce (není červené) a LEGO Botanicals květiny -->
            <div class="closing__couple-visual">
                <img src="static/images/lego-couple-heart.png" 
                     alt="Těšíme se na vás — 12. 6. 2027" 
                     width="480" 
                     height="360" 
                     loading="lazy" 
                     class="couple-heart-img">
            </div>

            <!-- "TĚŠÍME SE NA VÁS!" ve stejném moderním fontu jako tlačítko pod ním -->
            <h2 class="closing-headline-samefont">TĚŠÍME SE NA VÁS!</h2>

            <div class="closing__calendar-box">
                <a href="{{ _ics_file }}" class="btn btn--save-calendar" download>
                    Uložit datum 12. 6. 2027 do kalendáře (.ics)
                </a>
            </div>

            <div class="footer-names-line">
                <p class="script-footer-names">{{ couple.name_a }} &amp; {{ couple.name_b }}</p>
                <p class="footer-sub-text">{{ wedding.date | czech_date }} · {{ venue.name }}</p>
            </div>
        </div>
    </footer>

    <script src="static/main.js"></script>
</body>
</html>
