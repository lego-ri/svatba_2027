<!DOCTYPE html>
<html lang="{{ wedding.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ site.title }}</title>
    <meta name="description" content="{{ site.meta_description }}">
    {% if privacy.robots_noindex %}
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet">
    {% endif %}

    <!-- Google Fonts: Playfair Display + Dancing Script + Lora (with latin-ext) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    {# ── Barevná paleta jako CSS custom properties ── #}
    <style>
        :root {
            --color-primary:        {{ colors.primary }};
            --color-secondary:      {{ colors.secondary }};
            --color-yellow-bright:  {{ colors.yellow_bright }};
            --color-accent:         {{ colors.accent }};
            --color-bg:             {{ colors.background }};
            --color-card-bg:        {{ colors.card_bg }};
            --color-text:           {{ colors.text }};
            --color-text-dark:      {{ colors.text_dark }};
            --color-text-light:     {{ colors.text_light }};
            --color-border:         {{ colors.border }};
            --color-border-yellow:  {{ colors.border_yellow }};
        }
    </style>
    <link rel="stylesheet" href="static/style.css">
</head>
<body>

    {# ═══════════════════════════════════════════════ #}
    {# HERO SECTION                                   #}
    {# ═══════════════════════════════════════════════ #}
    <header id="hero" class="hero-section">
        <div class="hero-content">
            <p class="hero__label">Svatba</p>
            <h1 class="hero__names">{{ couple.name_a }} <span class="amp">&amp;</span> {{ couple.name_b }}</h1>
            <div class="hero__divider"></div>
            <p class="hero__date">{{ wedding.date | czech_date }}</p>
            <p class="hero__time">{{ wedding.time }}</p>
            <p class="hero__venue">{{ venue.name }}</p>
            <div class="hero__action">
                <a href="{{ _ics_file }}" class="btn btn--pill btn--primary" download>Přidat do kalendáře</a>
            </div>
        </div>
    </header>

    {# ═══════════════════════════════════════════════ #}
    {# STICKY NAV                                     #}
    {# ═══════════════════════════════════════════════ #}
    <nav id="nav" class="nav">
        <ul>
            <li><a href="#program">Program</a></li>
            <li><a href="#misto">Místo</a></li>
            <li><a href="#ubytovani">Ubytování</a></li>
            <li><a href="#dress-code">Dress code</a></li>
            <li><a href="#info">Info</a></li>
            <li><a href="#pozor">Důležité</a></li>
            <li><a href="#kontakt">Kontakt</a></li>
        </ul>
    </nav>

    <main>

        {# ═══════════════════════════════════════════════ #}
        {# HARMONOGRAM                                    #}
        {# ═══════════════════════════════════════════════ #}
        <section id="program" class="section">
            <h2 class="section-title">Program dne</h2>
            <div class="timeline">
                {% for event in schedule %}
                <div class="timeline__item">
                    <span class="timeline__time">{{ event.time }}</span>
                    <div class="timeline__body">
                        <h3>{{ event.title }}</h3>
                        {% if event.description %}
                        <p>{{ event.description }}</p>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>

        <div class="section-divider"></div>

        {# ═══════════════════════════════════════════════ #}
        {# MÍSTO & PARKOVÁNÍ                              #}
        {# ═══════════════════════════════════════════════ #}
        <section id="misto" class="section">
            <h2 class="section-title">Místo konání</h2>
            <p class="section-text venue-highlight">{{ venue.name }}</p>
            <p class="section-text">{{ venue.description }}</p>
            <div class="map-links">
                <a href="{{ venue.maps.google }}" target="_blank" rel="noopener" class="btn btn--pill btn--outline">Google Maps</a>
                <a href="{{ venue.maps.mapy_cz }}" target="_blank" rel="noopener" class="btn btn--pill btn--outline">Mapy.cz</a>
            </div>

            <div class="sub-divider"></div>

            <h3 class="sub-heading">Parkování</h3>
            <p class="section-text">{{ parking.description }}</p>
            <div class="map-links">
                <a href="{{ parking.maps.google }}" target="_blank" rel="noopener" class="btn btn--pill btn--outline">Google Maps</a>
                <a href="{{ parking.maps.mapy_cz }}" target="_blank" rel="noopener" class="btn btn--pill btn--outline">Mapy.cz</a>
            </div>

            <div class="sub-divider"></div>

            <h3 class="sub-heading">Doprava</h3>
            <p class="section-text">{{ transport.description }}</p>
        </section>

        <div class="section-divider"></div>

        {# ═══════════════════════════════════════════════ #}
        {# UBYTOVÁNÍ                                      #}
        {# ═══════════════════════════════════════════════ #}
        <section id="ubytovani" class="section">
            <h2 class="section-title">Ubytování</h2>
            <p class="section-text lead-text">{{ accommodation.description }}</p>
        </section>

        <div class="section-divider"></div>

        {# ═══════════════════════════════════════════════ #}
        {# DRESS CODE                                     #}
        {# ═══════════════════════════════════════════════ #}
        <section id="dress-code" class="section">
            <h2 class="section-title">Dress Code</h2>
            <p class="dress-code__style">{{ dress_code.style }}</p>
            <p class="section-text">{{ dress_code.description }}</p>
            <p class="dress-code__warning">{{ dress_code.terrain_warning }}</p>
        </section>

        <div class="section-divider"></div>

        {# ═══════════════════════════════════════════════ #}
        {# DARY, DĚTI, MAZLÍČCI                           #}
        {# ═══════════════════════════════════════════════ #}
        <section id="info" class="section">
            <h2 class="section-title">Praktické informace</h2>

            <div class="info-item">
                <h3>Dary</h3>
                <p>{{ gifts.description }}</p>
            </div>

            <div class="info-item">
                <h3>Děti</h3>
                <p>{{ children.note }}</p>
            </div>

            <div class="info-item">
                <h3>Mazlíčci</h3>
                <p>{{ pets.note }}</p>
            </div>
        </section>

        <div class="section-divider"></div>

        {# ═══════════════════════════════════════════════ #}
        {# ABY VÁS NIC NEPŘEKVAPILO                      #}
        {# ═══════════════════════════════════════════════ #}
        <section id="pozor" class="section">
            <h2 class="section-title">{{ surprises.title }}</h2>
            <div class="surprises-list">
                {% for item in surprises.entries %}
                <div class="surprise-item">
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.description }}</p>
                </div>
                {% endfor %}
            </div>
        </section>

        <div class="section-divider"></div>

        {# ═══════════════════════════════════════════════ #}
        {# KONTAKTY                                       #}
        {# ═══════════════════════════════════════════════ #}
        <section id="kontakt" class="section">
            <h2 class="section-title">Kontakty</h2>
            <p class="section-text contacts-intro">V den svatby prosíme volejte naše svědky.</p>
            <div class="contacts">
                {% for contact in contacts %}
                <div class="contact-card">
                    <h3>{{ contact.name }}</h3>
                    <p class="contact-card__role">{{ contact.role }}</p>
                    <a href="tel:{{ contact.phone | replace(' ', '') }}" class="btn btn--pill btn--outline">{{ contact.phone }}</a>
                </div>
                {% endfor %}
            </div>
        </section>

    </main>

    {# ═══════════════════════════════════════════════ #}
    {# FOOTER                                         #}
    {# ═══════════════════════════════════════════════ #}
    <footer class="footer">
        <p class="footer__names">{{ couple.name_a }} <span class="amp">&amp;</span> {{ couple.name_b }}</p>
        <p class="footer__date">{{ wedding.date | czech_date }} · {{ venue.name }}</p>
    </footer>

    <script src="static/main.js"></script>
</body>
</html>
